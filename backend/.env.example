# Contoh .env produksi — JANGAN commit .env asli (sudah di-gitignore di root).
# Lihat docs/BACKEND_PLAN.md §8.2 — TODO: isi nilai asli di server, bukan di repo.
PORT=8000
DMS_DB_PATH=app/var/dms.sqlite3      # atau postgresql://… saat tahap D (§6.4)
DMS_DEMO=0                           # 1 = mode demo (pita kuning) · 0 = data hari ini
DMS_PLANT=Snack
# Tahap C (auth) — TODO: isi dari IT/Entra tenant
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
DMS_SESSION_TTL_MINUTES=600
