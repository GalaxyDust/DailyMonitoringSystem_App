# ──────────────────────────────────────────────
# DMS — .gitignore (root)
# ──────────────────────────────────────────────

# ── Dependensi & hasil build ──
node_modules/
dist/
dist-ssr/
*.local

# ── Python ──
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# ── Environment & secrets ──
.env
.env.*
!.env.example

# ── Data runtime lokal (bukan repo) ──
app/var/
backend/var/
*.sqlite3
*.sqlite3-journal
*.db

# ── Log & OS ──
*.log
logs/
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ──
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
